---
import '../../tokens.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import { getCollection } from 'astro:content';
import { getLangFromPath, getNavText, getSwitchLangPath, getCollectionSuffix } from '../lib/i18n';
import { buildWorkflowMap } from '../lib/workflows';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// 检测当前语言
const currentPath = Astro.url.pathname;
const lang = getLangFromPath(currentPath);
const suffix = getCollectionSuffix(lang);

// 加载集合
const allWorkflows = await getCollection('workflows' + suffix);
const allAgents = await getCollection('agents' + suffix);
const allSkills = await getCollection('skills' + suffix);
const allProfiles = await getCollection('profiles' + suffix);

// 构建工作流映射
const workflowMap = await buildWorkflowMap(suffix);

// 导航文本
const navText = getNavText(lang);

// 语言切换路径
const switchLangPath = getSwitchLangPath(currentPath, lang === 'zh' ? 'en' : 'zh');

const pageTitle = title || (lang === 'en' ? 'AI Assets Hub' : 'AI 资产管理站');
const pageDescription = description || (lang === 'en' ? 'Manage and showcase AI assets' : '管理和展示 AI 资产');

function isActive(href: string) {
  const checkPath = lang === 'en' ? '/en' + href : href;
  if (href === '/' && (currentPath === '/' || currentPath === '/en' || currentPath === '/en/')) return true;
  if (href !== '/' && currentPath.startsWith(checkPath)) return true;
  return false;
}

// 工作流详情（传递给前端）
const workflowDetails = Object.fromEntries(
  Object.entries(workflowMap).map(([slug, wf]) => [slug, { overview: wf.overview, designPhilosophy: wf.designPhilosophy }])
);

// 移动端菜单状态
let mobileMenuOpen = false;
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle} · AI Assets Hub</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
        } catch (e) {}
      })();
    </script>
    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
      mermaid.initialize({
        startOnLoad: true,
        theme: document.documentElement.getAttribute('data-theme') === 'light' ? 'default' : 'dark',
        securityLevel: 'strict',
        flowchart: { useMaxWidth: false, htmlLabels: true, curve: 'basis' },
      });
    </script>
    <script is:inline src="/assets/asset-actions.js"></script>
  </head>
  <body>
    <div id="workflow-status" class="workflow-status"></div>
    <div class="app">
      <header class="nav">
        <a class="brand" href={lang === 'en' ? '/en/' : '/'}>
          <span class="brand-mark">◆</span>
          <span class="brand-name">AI Assets <b>Hub</b></span>
        </a>

        <!-- 桌面端导航 -->
        <nav class="nav-links" aria-label={lang === 'en' ? 'Main' : '主导航'}>
          <a href={lang === 'en' ? '/en/overview/' : '/overview/'} class={isActive('/overview/') ? 'active' : ''}>{navText.overview}</a>
          <a href={lang === 'en' ? '/en/skills/' : '/skills/'} class={isActive('/skills/') ? 'active' : ''}>{navText.skills}</a>
          <a href={lang === 'en' ? '/en/agents/' : '/agents/'} class={isActive('/agents/') ? 'active' : ''}>{navText.agents}</a>
          <a href={lang === 'en' ? '/en/workflows/' : '/workflows/'} class={isActive('/workflows/') ? 'active' : ''}>{navText.workflows}</a>
          <a href={lang === 'en' ? '/en/profiles/' : '/profiles/'} class={isActive('/profiles/') ? 'active' : ''}>{navText.profiles}</a>
          <a href={lang === 'en' ? '/en/graph/' : '/graph/'} class={isActive('/graph/') ? 'active' : ''}>{navText.graph}</a>
        </nav>

        <div class="nav-actions">
          <button id="workflowDownloadBtn" class="icon-btn" title={lang === 'en' ? 'Download workflow' : '下载当前工作流'} onclick="window.__downloadWorkflow()">📦</button>
          <select id="workflowSelector" class="workflow-select" aria-label={lang === 'en' ? 'Select workflow' : '选择工作流'}>
            <option value="">{lang === 'en' ? 'All Workflows' : '所有工作流'}</option>
            {Object.entries(workflowMap).map(([slug, wf]) => (
              <option value={slug}>{wf.title}</option>
            ))}
          </select>
          <a class="search-link" href={lang === 'en' ? '/en/search/' : '/search/'}>{navText.search}</a>
          <button class="icon-btn" id="themeBtn" aria-label="Toggle theme" title="Theme">◐</button>
          <a class="lang-switch" href={switchLangPath} title={lang === 'en' ? '切换到中文' : 'Switch to English'}>
            {lang === 'en' ? '中' : 'EN'}
          </a>
          <button class="icon-btn mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu" aria-expanded="false">☰</button>
        </div>
      </header>

      <!-- 移动端导航菜单 -->
      <div class="mobile-nav" id="mobileNav">
        <nav class="mobile-nav-links">
          <a href={lang === 'en' ? '/en/overview/' : '/overview/'} class={isActive('/overview/') ? 'active' : ''}>{navText.overview}</a>
          <a href={lang === 'en' ? '/en/skills/' : '/skills/'} class={isActive('/skills/') ? 'active' : ''}>{navText.skills}</a>
          <a href={lang === 'en' ? '/en/agents/' : '/agents/'} class={isActive('/agents/') ? 'active' : ''}>{navText.agents}</a>
          <a href={lang === 'en' ? '/en/workflows/' : '/workflows/'} class={isActive('/workflows/') ? 'active' : ''}>{navText.workflows}</a>
          <a href={lang === 'en' ? '/en/profiles/' : '/profiles/'} class={isActive('/profiles/') ? 'active' : ''}>{navText.profiles}</a>
          <a href={lang === 'en' ? '/en/graph/' : '/graph/'} class={isActive('/graph/') ? 'active' : ''}>{navText.graph}</a>
          <a href={lang === 'en' ? '/en/search/' : '/search/'} class={isActive('/search/') ? 'active' : ''}>{navText.search}</a>
        </nav>
      </div>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <p>AI Assets Hub · Built with Astro</p>
      </footer>
    </div>

    <script is:inline set:html={`window.__WORKFLOWS__ = ${JSON.stringify(workflowMap)}; window.__LANG__ = '${lang}';`} />
    <script is:inline set:html={`window.__WORKFLOW_DETAILS__ = ${JSON.stringify(workflowDetails)};`} />

    <script>
      // 主题切换
      document.getElementById('themeBtn')?.addEventListener('click', () => {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        if (isLight) {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
        }
      });

      // 移动端菜单
      const mobileMenuBtn = document.getElementById('mobileMenuBtn');
      const mobileNav = document.getElementById('mobileNav');
      if (mobileMenuBtn && mobileNav) {
        mobileMenuBtn.addEventListener('click', () => {
          const open = mobileNav.classList.toggle('open');
          mobileMenuBtn.textContent = open ? '✕' : '☰';
          mobileMenuBtn.setAttribute('aria-expanded', String(open));
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Hallmark · genre: modern-minimal · theme: brand-violet (custom) · design-system: design.md · designed-as-app */

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; overflow-x: clip; }
  body {
    overflow-x: clip;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    font-size: 16px;
  }
  code, pre { font-family: var(--font-mono); }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; }
  ::selection { background: var(--color-accent); color: var(--color-accent-ink); }

  :focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .app { display: flex; flex-direction: column; min-height: 100vh; }

  /* ========== 导航 —— 浮起工具条 ========== */
  .nav {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-md);
    width: 100%; max-width: var(--maxw);
    margin: var(--space-sm) auto 0;
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-rule-soft);
    border-radius: var(--radius-pill);
    background: color-mix(in oklch, var(--color-paper-2) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .brand { display: flex; align-items: center; gap: var(--space-2xs); font-size: 15px; font-weight: 600; flex-shrink: 0; letter-spacing: -0.01em; }
  .brand-mark {
    width: 26px; height: 26px; flex-shrink: 0;
    display: grid; place-items: center;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-sm);
    font-size: 13px;
  }
  .brand-name b { color: var(--color-accent); font-weight: 700; }

  .nav-links { display: flex; align-items: center; gap: var(--space-sm); font-size: 13.5px; }
  .nav-links a { color: var(--color-ink-2); padding: var(--space-2xs) var(--space-xs); border-radius: var(--radius-pill); transition: color var(--dur-short) var(--ease-out), background var(--dur-short) var(--ease-out); }
  .nav-links a:hover { color: var(--color-ink); }
  .nav-links a.active { color: var(--color-accent); background: color-mix(in oklch, var(--color-accent) 12%, transparent); }

  .nav-actions { display: flex; align-items: center; gap: var(--space-2xs); flex-shrink: 0; }

  .icon-btn {
    background: none; border: 1px solid var(--color-rule);
    color: var(--color-ink-2); cursor: pointer;
    font-size: 14px; width: 30px; height: 30px;
    border-radius: var(--radius-pill);
    display: flex; align-items: center; justify-content: center;
    transition: all var(--dur-short) var(--ease-out); padding: 0;
  }
  .icon-btn:hover { border-color: var(--color-accent); color: var(--color-ink); }
  .icon-btn:active { transform: translateY(1px); }
  .workflow-download-btn.loading { animation: spin 1s linear infinite; }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  .workflow-select {
    background: var(--color-paper-2); color: var(--color-ink);
    border: 1px solid var(--color-rule); border-radius: var(--radius-pill);
    padding: 5px 10px; font-size: 12px; cursor: pointer; outline: none;
    transition: border-color var(--dur-short) var(--ease-out); max-width: 150px;
    font-family: var(--font-body);
  }
  .workflow-select:hover, .workflow-select:focus-visible { border-color: var(--color-accent); }

  .search-link { font-size: 13.5px; color: var(--color-ink-2); padding: var(--space-2xs) var(--space-xs); border-radius: var(--radius-pill); transition: color var(--dur-short) var(--ease-out); display: none; }
  .search-link:hover { color: var(--color-ink); }

  .lang-switch {
    font-size: 11px; font-weight: 600; padding: 6px 10px; border-radius: var(--radius-pill);
    border: 1px solid var(--color-rule); color: var(--color-ink-2);
    transition: all var(--dur-short) var(--ease-out); display: none;
    font-family: var(--font-body);
  }
  .lang-switch:hover { border-color: var(--color-accent); color: var(--color-ink); }

  .mobile-menu-btn { display: none; }

  /* 移动端导航 */
  .mobile-nav {
    display: none;
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: var(--color-paper); z-index: 40; padding: calc(var(--space-3xl) + 8px) var(--space-md) var(--space-md);
    overflow-y: auto;
  }
  .mobile-nav.open { display: block; }
  .mobile-nav-links { display: flex; flex-direction: column; gap: var(--space-2xs); max-width: 600px; margin: 0 auto; }
  .mobile-nav-links a {
    font-size: 17px; color: var(--color-ink-2); padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .mobile-nav-links a.active { color: var(--color-accent); }

  /* ========== 主体内容 ========== */
  .main { flex: 1; width: 100%; max-width: var(--maxw); margin: 0 auto; padding: var(--space-2xl) var(--space-md) var(--space-3xl); }
  .footer { text-align: center; padding: var(--space-lg) var(--space-md); color: var(--color-ink-3); font-size: 13px; border-top: 1px solid var(--color-rule-soft); }

  /* ========== 通用 section head ========== */
  .section-head { margin-bottom: var(--space-xl); }

  /* ========== 列表页 hero head（与概览页呼应） ========== */
  .page-head {
    position: relative;
    padding: var(--space-lg) 0 var(--space-lg);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .page-head-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }
  .page-count {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: var(--space-xs);
    color: var(--color-ink);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .page-desc { color: var(--color-ink-2); font-size: var(--text-md); max-width: var(--measure); }
  .kicker {
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-accent-2); margin-bottom: var(--space-xs);
    font-weight: 500;
  }
  .kicker.skill { color: var(--color-accent); }
  .kicker.agent { color: var(--color-accent-2); }
  .kicker.workflow { color: var(--color-warn); }
  .kicker.profile { color: var(--color-good); }

  /* 详情页类型主题色：data-kind → --page-accent */
  .detail-layout[data-kind="skill"] { --page-accent: var(--color-accent); }
  .detail-layout[data-kind="agent"] { --page-accent: var(--color-accent-2); }
  .detail-layout[data-kind="workflow"] { --page-accent: var(--color-warn); }
  .detail-layout[data-kind="profile"] { --page-accent: var(--color-good); }
  .section-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    letter-spacing: -0.02em; line-height: 1.2;
    margin-bottom: var(--space-xs);
  }
  .section-sub { color: var(--color-ink-2); font-size: var(--text-md); max-width: var(--measure); }

  /* ========== 通用卡片网格 ========== */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--space-md);
  }

  /* ========== 响应式断点 ========== */
  @media (min-width: 1200px) {
    .search-link { display: inline; }
    .lang-switch { display: inline; }
  }
  @media (max-width: 1199px) {
    .search-link { display: inline; }
    .lang-switch { display: inline; }
    .workflow-select { max-width: 120px; font-size: 11px; }
  }
  @media (max-width: 860px) {
    .nav-links { display: none; }
    .mobile-menu-btn { display: flex; }
    .search-link { display: none; }
    .lang-switch { display: none; }
    .nav { margin-top: 0; border-radius: 0; border-left: none; border-right: none; border-top: none; background: color-mix(in oklch, var(--color-paper) 85%, transparent); }
  }
  @media (max-width: 560px) {
    .workflow-select { max-width: 96px; font-size: 10.5px; }
    .brand-name { font-size: 13.5px; }
    .main { padding-top: var(--space-xl); }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
