---
// src/components/Card.astro
interface Props {
  title: string;
  description: string;
  href: string;
  kind: string;
  version?: string;
  tags?: string[];
  meta?: string;
}

const { title, description, href, kind, version, tags, meta } = Astro.props;
---

<a class="card" href={href} data-kind={kind}>
  <div class="card-actions">
    <button class="asset-card-btn" data-slug={href.split('/').filter(Boolean).pop()} data-kind={kind + "s"} data-action="copy" title="📋">📋</button>
    <button class="asset-card-btn" data-slug={href.split('/').filter(Boolean).pop()} data-kind={kind + "s"} data-action="download" title="⬇">⬇</button>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="card-meta">
    <span class="tag kind">{kind}</span>
    {version && <span class="tag version">v{version}</span>}
    {meta && <span class="tag">{meta}</span>}
    {(tags || []).slice(0, 2).map(t => <span class="tag">#{t}</span>)}
  </div>
</a>

<style>
  .card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    transition: border-color 0.2s, transform 0.2s;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card h3 {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 6px;
  }
  .card p {
    font-size: 13px;
    color: var(--text-dim);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
  .card-meta {
    display: flex;
    gap: 6px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .card-actions {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .card:hover .card-actions,
  .card-actions:focus-within {
    opacity: 1;
  }
  .asset-card-btn {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-dim);
    cursor: pointer;
    font-size: 12px;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
    padding: 0;
  }
  .asset-card-btn:hover {
    border-color: var(--accent);
    color: var(--text);
    background: var(--bg-card);
  }
  .tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--bg-elevated);
    color: var(--text-dim);
    border: 1px solid var(--border-soft);
  }
  .tag.kind { color: var(--accent-2); border-color: rgba(77, 214, 200, 0.3); }
  .tag.version { color: var(--accent); border-color: rgba(124, 108, 255, 0.3); }
</style>
