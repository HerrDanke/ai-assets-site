---
// src/components/Card.astro
interface Props {
  title: string;
  description: string;
  href: string;
  kind: string;
  version?: string;
  tags?: string[];
  meta?: string;
}

const { title, description, href, kind, version, tags, meta } = Astro.props;

// 内容标签哈希配色：同一标签恒定一色，不同标签区分
const TAG_COLORS = ['tag-c0', 'tag-c1', 'tag-c2', 'tag-c3', 'tag-c4'];
function tagColor(tag: string) {
  let h = 0;
  for (let i = 0; i < tag.length; i++) h = (h * 31 + tag.charCodeAt(i)) % 997;
  return TAG_COLORS[h % TAG_COLORS.length];
}
---

<a class="card" href={href} data-kind={kind}>
  <div class="card-actions">
    <button class="asset-card-btn" data-slug={href.split('/').filter(Boolean).pop()} data-kind={kind + "s"} data-action="copy" title="📋">📋</button>
    <button class="asset-card-btn" data-slug={href.split('/').filter(Boolean).pop()} data-kind={kind + "s"} data-action="download" title="⬇">⬇</button>
  </div>
  <div class="card-top">
    <span class={`card-kind ${kind}`}>{kind}</span>
    {meta && <span class="card-meta-pill">{meta}</span>}
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <div class="card-meta">
    {(tags || []).slice(0, 2).map(t => <span class={`tag ${tagColor(t)}`}>#{t}</span>)}
  </div>
</a>

<style>
  /* Hallmark · component: card · genre: modern-minimal · theme: brand-violet (custom) */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    transition: border-color var(--dur-md) var(--ease-out), transform var(--dur-md) var(--ease-out), box-shadow var(--dur-md) var(--ease-out);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }
  .card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    opacity: 0;
    transition: opacity var(--dur-md) var(--ease-out);
  }
  .card:hover {
    border-color: var(--color-rule);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px color-mix(in oklch, var(--color-accent) 10%, transparent);
  }
  .card:hover::before { opacity: 1; }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }
  .card-kind {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }
  /* 每种资产类型一种强调色 */
  .card-kind.skill { color: var(--color-accent); }
  .card-kind.agent { color: var(--color-accent-2); }
  .card-kind.workflow { color: var(--color-warn); }
  .card-kind.profile { color: var(--color-good); }

  .card-meta-pill {
    font-family: var(--font-mono);
    font-size: 10.5px;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-elevated);
    color: var(--color-ink-2);
    border: 1px solid var(--color-rule-soft);
    white-space: nowrap;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 var(--space-2xs);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 var(--space-md);
    line-height: 1.6;
  }
  .card-meta { display: flex; gap: var(--space-2xs); flex-wrap: wrap; margin-top: auto; }

  .card-actions {
    position: absolute;
    top: var(--space-xs);
    right: var(--space-xs);
    display: flex;
    gap: var(--space-3xs);
    opacity: 0;
    transition: opacity var(--dur-short) var(--ease-out);
  }
  .card:hover .card-actions,
  .card-actions:focus-within { opacity: 1; }

  .asset-card-btn {
    background: var(--color-elevated);
    border: 1px solid var(--color-rule);
    color: var(--color-ink-2);
    cursor: pointer;
    font-size: 12px;
    width: 26px; height: 26px;
    border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
    transition: all var(--dur-short) var(--ease-out);
    padding: 0;
  }
  .asset-card-btn:hover { border-color: var(--color-accent); color: var(--color-ink); background: var(--color-paper-2); }
  .asset-card-btn:active { transform: translateY(1px); }

  .tag {
    font-size: var(--text-xs);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-elevated);
    color: var(--color-ink-2);
    border: 1px solid var(--color-rule-soft);
    font-family: var(--font-mono);
  }
  /* 内容标签哈希配色（淡色底 + 彩色文字） */
  .tag-c0 { color: var(--color-accent);     border-color: color-mix(in oklch, var(--color-accent) 35%, transparent);     background: color-mix(in oklch, var(--color-accent) 10%, transparent); }
  .tag-c1 { color: var(--color-accent-2);   border-color: color-mix(in oklch, var(--color-accent-2) 35%, transparent);   background: color-mix(in oklch, var(--color-accent-2) 10%, transparent); }
  .tag-c2 { color: var(--color-warn);       border-color: color-mix(in oklch, var(--color-warn) 35%, transparent);       background: color-mix(in oklch, var(--color-warn) 10%, transparent); }
  .tag-c3 { color: var(--color-good);       border-color: color-mix(in oklch, var(--color-good) 35%, transparent);       background: color-mix(in oklch, var(--color-good) 10%, transparent); }
  .tag-c4 { color: var(--color-bad);        border-color: color-mix(in oklch, var(--color-bad) 35%, transparent);        background: color-mix(in oklch, var(--color-bad) 10%, transparent); }
</style>
