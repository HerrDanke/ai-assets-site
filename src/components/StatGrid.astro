---
// src/components/StatGrid.astro
interface Stat {
  label: string;
  count: number;
  href: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="stat-grid">
  {stats.map(s => (
    <a class="stat-link" href={s.href}>
      <div class="stat">
        <b class="stat-num">{s.count}</b>
        <span class="stat-label">{s.label}</span>
      </div>
    </a>
  ))}
</div>

<style>
  /* Hallmark · component: stat-grid · genre: modern-minimal · theme: brand-violet (custom) */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-md);
  }
  .stat-link { text-decoration: none; color: inherit; }
  .stat {
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-md);
    text-align: center;
    cursor: pointer;
    transition: transform var(--dur-md) var(--ease-out), border-color var(--dur-md) var(--ease-out);
  }
  .stat:hover { transform: translateY(-3px); border-color: var(--color-rule); }
  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-2xs);
  }
  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
