---
// src/components/WorkflowHeader.astro
import { type WorkflowMap } from '../lib/workflows';

interface Props {
  workflow: WorkflowMap[string] | null;
  slug: string;
}

const { workflow, slug } = Astro.props;
---

{workflow ? (
  <section class="wf-hero">
    <h1 class="wf-title">
      <span class="wf-title-accent">{workflow.title}</span>
    </h1>
  </section>
) : (
  <section class="wf-hero">
    <h1 class="wf-title">请选择一个工作流</h1>
  </section>
)}

<style>
  /* Hallmark · component: workflow-header · genre: modern-minimal · theme: brand-violet (custom) */
  .wf-hero {
    text-align: center;
    padding: var(--space-xl) 0 var(--space-lg);
  }
  .wf-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .wf-title-accent { color: var(--color-accent); }
</style>
