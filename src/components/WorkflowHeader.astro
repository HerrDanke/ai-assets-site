---
// src/components/WorkflowHeader.astro
import { type WorkflowMap } from '../lib/workflows';

interface Props {
  workflow: WorkflowMap[string] | null;
  slug: string;
}

const { workflow, slug } = Astro.props;
---

{workflow ? (
  <section class="hero-large">
    <h1 class="hero-title-large">
      <span class="gradient-text">{workflow.title}</span>
    </h1>
  </section>
) : (
  <section class="hero-large">
    <h1 class="hero-title-large">请选择一个工作流</h1>
  </section>
)}

<style>
  .hero-large {
    text-align: center;
    padding: 80px 0 60px;
  }
  .hero-title-large {
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--text);
  }
  .gradient-text {
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
