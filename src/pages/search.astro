---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'zh';

const skills = await getCollection('skillsZh');
const agents = await getCollection('agentsZh');
const workflows = await getCollection('workflowsZh');
const profiles = await getCollection('profilesZh');
const tools = await getCollection('toolsZh');
const prompts = await getCollection('promptsZh');

const allItems = [
  ...skills.map(s => ({ slug: s.slug, kind: 'skills', title: s.data.title, description: s.data.description, tags: s.data.tags ?? [], version: s.data.version })),
  ...agents.map(a => ({ slug: a.slug, kind: 'agents', title: a.data.title, description: a.data.description, tags: a.data.tags ?? [], version: a.data.version })),
  ...workflows.map(w => ({ slug: w.slug, kind: 'workflows', title: w.data.title, description: w.data.description, tags: w.data.tags ?? [], version: w.data.version })),
  ...profiles.map(p => ({ slug: p.slug, kind: 'profiles', title: p.data.title, description: p.data.description, tags: p.data.tags ?? [], version: p.data.version })),
  ...tools.map(t => ({ slug: t.slug, kind: 'tools', title: t.data.title, description: t.data.description, tags: t.data.tags ?? [], version: t.data.version })),
  ...prompts.map(p => ({ slug: p.slug, kind: 'prompts', title: p.data.title, description: p.data.description, tags: p.data.tags ?? [], version: p.data.version })),
];
---

<BaseLayout title="搜索" description="搜索所有资产">
  <section class="page-head">
    <div class="page-head-kicker">
      <span class="kicker">Search</span>
      <span class="page-count">{allItems.length}</span>
    </div>
    <h1 class="page-title">搜索</h1>
    <p class="page-desc">搜索所有 AI 资产</p>
  </section>

  <div class="search-container">
    <input
      type="text"
      id="search-input"
      class="search-input"
      placeholder="输入关键词搜索标题、描述、标签..."
      autocomplete="off"
    />
    <div class="search-filters">
      <button class="filter-btn active" data-filter="all">全部</button>
      <button class="filter-btn" data-filter="skills">Skills</button>
      <button class="filter-btn" data-filter="agents">Agents</button>
      <button class="filter-btn" data-filter="workflows">Workflows</button>
      <button class="filter-btn" data-filter="profiles">Profiles</button>
      <button class="filter-btn" data-filter="tools">Tools</button>
      <button class="filter-btn" data-filter="prompts">Prompts</button>
    </div>
    <div id="search-results" class="card-grid">
      {allItems.map(item => (
        <a class="search-card" href={`/${item.kind}/${item.slug}/`} data-slug={item.slug} data-kind={item.kind} data-search-title={item.title.toLowerCase()} data-search-desc={item.description.toLowerCase()} data-search-tags={item.tags.join(' ').toLowerCase()}>
          <span class={`search-kind ${item.kind}`}>{item.kind}</span>
          <h3 class="search-title">{item.title}</h3>
          <p class="search-desc">{item.description}</p>
        </a>
      ))}
    </div>
    <div id="search-empty" class="search-empty" style="display: none;">
      <p>未找到匹配的资产</p>
    </div>
  </div>
</BaseLayout>

<style>
  /* Hallmark · genre: modern-minimal · macrostructure: Index-First · theme: brand-violet (custom) · design-system: design.md · designed-as-app */
  .search-container { max-width: 100%; }

  .search-input {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    font-size: var(--text-md);
    font-family: var(--font-body);
    outline: none;
    transition: border-color var(--dur-short) var(--ease-out);
    margin-bottom: var(--space-md);
  }
  .search-input:focus-visible { border-color: var(--color-accent); }
  .search-input::placeholder { color: var(--color-ink-3); }

  .search-filters { display: flex; gap: var(--space-2xs); flex-wrap: wrap; margin-bottom: var(--space-lg); }
  .filter-btn {
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule-soft);
    color: var(--color-ink-2);
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-size: var(--text-sm);
    font-family: var(--font-body);
    transition: all var(--dur-short) var(--ease-out);
  }
  .filter-btn:hover { border-color: var(--color-accent); color: var(--color-ink); }
  .filter-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); }
  .filter-btn:active { transform: translateY(1px); }

  .search-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    transition: border-color var(--dur-md) var(--ease-out), transform var(--dur-md) var(--ease-out);
    text-decoration: none;
    color: inherit;
  }
  .search-card:hover { border-color: var(--color-rule); transform: translateY(-2px); }
  .search-kind {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2xs);
  }
  .search-kind.skills { color: var(--color-accent); }
  .search-kind.agents { color: var(--color-accent-2); }
  .search-kind.workflows { color: var(--color-warn); }
  .search-kind.profiles { color: var(--color-good); }
  .search-kind.tools, .search-kind.prompts { color: var(--color-ink-2); }
  .search-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-2xs);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .search-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 var(--space-sm);
    line-height: 1.6;
  }
  .search-card .tag {
    font-size: var(--text-xs);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-elevated);
    color: var(--color-ink-2);
    border: 1px solid var(--color-rule-soft);
    font-family: var(--font-mono);
  }
  .search-empty { text-align: center; padding: var(--space-2xl) var(--space-md); color: var(--color-ink-3); }
</style>

<script>
  const searchInput = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const emptyState = document.getElementById('search-empty');
  const filterBtns = document.querySelectorAll('.filter-btn');
  let activeFilter = 'all';

  function performSearch() {
    const query = searchInput.value.toLowerCase().trim();
    const cards = resultsContainer.querySelectorAll('.search-card');
    let visibleCount = 0;

    cards.forEach(card => {
      const kind = card.dataset.kind;
      const title = card.dataset.searchTitle || '';
      const desc = card.dataset.searchDesc || '';
      const tags = card.dataset.searchTags || '';

      const matchesFilter = activeFilter === 'all' || kind === activeFilter;
      const matchesQuery = !query || title.includes(query) || desc.includes(query) || tags.includes(query);

      if (matchesFilter && matchesQuery) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  searchInput.addEventListener('input', performSearch);

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.dataset.filter;
      performSearch();
    });
  });
</script>
