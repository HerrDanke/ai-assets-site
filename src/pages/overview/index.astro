---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCollectionSuffix } from '../../lib/i18n';
import StatGrid from '../../components/StatGrid.astro';

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const suffix = getCollectionSuffix(lang);

const skills = await getCollection('skills' + suffix);
const agents = await getCollection('agents' + suffix);
const workflows = await getCollection('workflows' + suffix);
const profiles = await getCollection('profiles' + suffix);

const stats = [
  { label: 'Skills', count: skills.length, href: lang === 'en' ? '/en/skills/' : '/skills/' },
  { label: 'Agents', count: agents.length, href: lang === 'en' ? '/en/agents/' : '/agents/' },
  { label: 'Workflows', count: workflows.length, href: lang === 'en' ? '/en/workflows/' : '/workflows/' },
  { label: 'Profiles', count: profiles.length, href: lang === 'en' ? '/en/profiles/' : '/profiles/' },
];
---

<BaseLayout title={lang === 'en' ? 'Overview' : '概览'} description={lang === 'en' ? 'AI Assets Overview' : 'AI 资产概览'}>
  <div id="homeAll" style="display:none;">
    <section class="overview-hero">
      <span class="kicker">{lang === 'en' ? 'Index' : '资产索引'}</span>
      <h1 class="overview-title">AI Assets <span class="accent">Hub</span></h1>
      <p class="overview-sub">{lang === 'en' ? 'Manage and showcase AI assets' : '管理和展示 AI 资产'}</p>
    </section>

    <section class="overview-stats">
      <StatGrid stats={stats} />
    </section>
  </div>

  <div id="homeWorkflow" style="display:none;">
    <div id="workflowContent"></div>
  </div>
</BaseLayout>

<script is:inline>
  function initHome() {
    var saved = localStorage.getItem('sp-workflow') || document.getElementById('workflowSelector').value;
    var allDiv = document.getElementById('homeAll');
    var wfDiv = document.getElementById('homeWorkflow');
    var contentDiv = document.getElementById('workflowContent');
    var lang = window.__LANG__ || 'zh';

    if (!saved) {
      allDiv.style.display = 'block';
      wfDiv.style.display = 'none';
    } else {
      allDiv.style.display = 'none';
      wfDiv.style.display = 'block';

      var overview = window.__WORKFLOW_DETAILS__ && window.__WORKFLOW_DETAILS__[saved] ? window.__WORKFLOW_DETAILS__[saved] : null;
      var wf = window.__WORKFLOWS__[saved];
      var html = '';
      if (overview) {
        html += '<section style="text-align:center;padding:80px 0 60px;">';
        html += '<h1 style="font-family:var(--font-display);font-size:clamp(1.75rem,4vw,3rem);font-weight:700;letter-spacing:-0.03em;margin:0;color:var(--color-accent);">' + (wf ? wf.title : saved) + '</h1>';
        html += '</section>';
        if (overview.overview) {
          html += '<section style="max-width:780px;margin:0 auto 48px;padding:0 24px;"><h2 style="font-family:var(--font-display);font-size:var(--text-xl);font-weight:700;margin-bottom:20px;text-align:center;letter-spacing:-0.02em;">' + (lang === 'en' ? 'Overview' : '概述') + '</h2><div style="line-height:1.8;color:var(--color-ink-2);">' + overview.overview + '</div></section>';
        }
        if (overview.designPhilosophy) {
          html += '<section style="max-width:900px;margin:0 auto 48px;padding:0 24px;"><h2 style="font-family:var(--font-display);font-size:var(--text-xl);font-weight:700;margin-bottom:20px;text-align:center;letter-spacing:-0.02em;">' + (lang === 'en' ? 'Design Philosophy' : '设计哲学') + '</h2><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">' + renderCards(overview.designPhilosophy) + '</div></section>';
        }
      } else {
        html = '<section style="text-align:center;padding:80px 0;"><h1 style="font-family:var(--font-display);font-size:clamp(1.75rem,4vw,3rem);font-weight:700;letter-spacing:-0.03em;">' + (lang === 'en' ? 'Please select a workflow' : '请选择一个工作流') + '</h1></section>';
      }
      contentDiv.innerHTML = html;
    }

    function renderCards(text) {
      var cards = '';
      var sections = text.split(/^(?=## )/m);
      for (var i = 0; i < sections.length; i++) {
        var section = sections[i].trim();
        if (!section) continue;
        var lines = section.split('\n');
        var sectionTitle = lines[0].replace(/^##\s*/, '');
        var restContent = lines.slice(1).join('\n').trim();
        var subParts = restContent.split(/^(?=### )/m);
        if (subParts.length > 1) {
          for (var j = 0; j < subParts.length; j++) {
            var part = subParts[j].trim();
            if (!part) continue;
            var partLines = part.split('\n');
            var subTitle = partLines[0].replace(/^###\s*/, '');
            var subContent = partLines.slice(1).join('\n').trim();
            cards += '<div style="background:var(--color-paper-2);border:1px solid var(--color-rule-soft);border-radius:var(--radius-lg);padding:20px;min-height:160px;display:flex;flex-direction:column;">';
            cards += '<h3 style="font-family:var(--font-display);font-size:var(--text-md);font-weight:600;margin:0 0 10px;color:var(--color-accent-2);">' + subTitle + '</h3>';
            if (subContent) {
              cards += '<div style="line-height:1.7;color:var(--color-ink-2);flex:1;font-size:var(--text-sm);"><p style="margin:0;">' + subContent.replace(/\n/g, '<br>') + '</p></div>';
            }
            cards += '</div>';
          }
        } else {
          cards += '<div style="background:var(--color-paper-2);border:1px solid var(--color-rule-soft);border-radius:var(--radius-lg);padding:20px;min-height:160px;display:flex;flex-direction:column;">';
          cards += '<h3 style="font-family:var(--font-display);font-size:var(--text-md);font-weight:600;margin:0 0 10px;color:var(--color-accent-2);">' + sectionTitle + '</h3>';
          if (restContent) {
            cards += '<div style="line-height:1.7;color:var(--color-ink-2);flex:1;font-size:var(--text-sm);"><p style="margin:0;">' + restContent.replace(/\n/g, '<br>') + '</p></div>';
          }
          cards += '</div>';
        }
      }
      return cards;
    }
  }

  document.addEventListener('workflow:filter', initHome);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { setTimeout(initHome, 500); });
  } else {
    setTimeout(initHome, 500);
  }
</script>

<style>
  /* Hallmark · genre: modern-minimal · macrostructure: Stat-Led · theme: brand-violet (custom) · design-system: design.md · designed-as-app */
  .overview-hero { text-align: center; padding: var(--space-2xl) 0 var(--space-lg); }
  .overview-title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: var(--space-sm);
    color: var(--color-ink);
  }
  .overview-title .accent { color: var(--color-accent); }
  .overview-sub { font-size: var(--text-lg); color: var(--color-ink-2); }
  .overview-stats { margin-top: var(--space-md); }
</style>
