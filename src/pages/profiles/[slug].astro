---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'zh';

export async function getStaticPaths() {
  const profiles = await getCollection('profilesZh');
  return profiles.map(p => ({
    params: { slug: p.slug },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const { data } = entry;
---

<BaseLayout title={data.title} description={data.description}>
  <div class="detail-layout">
    <article class="detail-content">
      <h1 class="section-title">{data.title}</h1>
      <p class="section-sub">{data.description}</p>
      <div class="markdown-body">
        {data.traits && data.traits.length > 0 && (
          <section class="profile-section">
            <h2>特质</h2>
            <div class="trait-grid">
              {data.traits.map(trait => (
                <div class="trait-card">
                  <span class="trait-icon">✦</span>
                  <span>{trait}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {data.thinkingStyle && data.thinkingStyle.length > 0 && (
          <section class="profile-section">
            <h2>思维模式</h2>
            <div class="thinking-list">
              {data.thinkingStyle.map((style, i) => (
                <div class="thinking-item">
                  <span class="thinking-num">{i + 1}</span>
                  <span>{style}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {data.applicableScenarios && data.applicableScenarios.length > 0 && (
          <section class="profile-section">
            <h2>适用场景</h2>
            <div class="scenario-tags">
              {data.applicableScenarios.map(scene => (
                <span class="scenario-tag">{scene}</span>
              ))}
            </div>
          </section>
        )}

        <Content />
      </div>
    </article>
    <aside class="detail-sidebar">
      {data.tags && data.tags.length > 0 && (
        <div class="sidebar-card">
          <h4>标签</h4>
          <div class="card-meta">
            {data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      )}

      {data.usedBy && data.usedBy.length > 0 && (
        <div class="sidebar-card">
          <h4>使用 Agent</h4>
          <ul class="sidebar-list">
            {data.usedBy.map(agent => (
              <li><a href={`/agents/${agent}/`}>{agent}</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="sidebar-card sidebar-actions">
        <button class="asset-card-btn" data-slug={entry.slug} data-kind="profiles" data-action="copy"       Markdown" style="width: 100%; height: auto; padding: 8px;">📋 复制 Markdown</button>
        <button class="asset-card-btn" data-slug={entry.slug} data-kind="profiles" data-action="download" title="下载 .md" style="width: 100%; height: auto; padding: 8px;">⬇ 下载 .md</button>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .detail-content { min-width: 0; }
  .markdown-body {
    margin-top: 24px;
    line-height: 1.8;
    font-size: 15px;
  }
  .profile-section {
    margin-bottom: 36px;
  }
  .profile-section h2 {
    font-size: 22px;
    margin: 40px 0 20px;
    font-weight: 700;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--accent);
    display: inline-block;
  }
  .profile-section h2:first-of-type {
    margin-top: 24px;
  }

  /* 特质卡片网格 */
  .trait-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }
  .trait-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.6;
    transition: border-color 0.2s, transform 0.2s;
  }
  .trait-card:hover {
    border-color: var(--accent-2);
    transform: translateY(-2px);
  }
  .trait-icon {
    color: var(--accent-2);
    font-size: 14px;
    margin-top: 2px;
    flex-shrink: 0;
  }

  /* 思维模式列 */
  .thinking-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .thinking-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 18px;
    background: var(--bg-soft);
    border-left: 3px solid var(--accent-2);
    border-radius: 0 8px 8px 0;
    font-size: 14px;
    line-height: 1.7;
  }
  .thinking-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: var(--accent-2);
    color: #0a0b10;
    font-size: 12px;
    font-weight: 700;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* 适用场景标签 */
  .scenario-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .scenario-tag {
    padding: 8px 18px;
    background: linear-gradient(135deg, var(--bg-card), var(--bg-elevated));
    border: 1px solid var(--border);
    border-radius: 99px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    transition: all 0.2s;
  }
  .scenario-tag:hover {
    border-color: var(--accent-2);
    background: var(--bg-card);
    box-shadow: 0 2px 8px rgba(124, 108, 255, 0.15);
  }

  .markdown-body :global(h2) {
    font-size: 20px;
    margin: 32px 0 12px;
    font-weight: 600;
  }
  .markdown-body :global(h3) {
    font-size: 17px;
    margin: 24px 0 10px;
    font-weight: 600;
  }
  .markdown-body :global(p) {
    margin-bottom: 16px;
    color: var(--text-dim);
  }
  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin: 12px 0 16px;
    padding-left: 24px;
    color: var(--text-dim);
  }
  .markdown-body :global(li) {
    margin-bottom: 6px;
  }
  .markdown-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 14px;
  }
  .markdown-body :global(th), .markdown-body :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--border);
    text-align: left;
  }
  .markdown-body :global(th) {
    background: var(--bg-elevated);
    font-weight: 600;
  }
  .markdown-body :global(code) {
    background: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
  }
  .markdown-body :global(pre) {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    overflow-x: auto;
  }
  .mermaid :global(svg) {
    max-width: 100% !important;
    height: auto !important;
    margin: 16px 0;
  }
  .markdown-body :global(pre code) {
    background: none;
    padding: 0;
  }
  .detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sidebar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .sidebar-card h4 {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--text);
  }
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-list li {
    margin-bottom: 6px;
    font-size: 13px;
    color: var(--text-dim);
  }
  .sidebar-list a {
    color: var(--accent-2);
    transition: color 0.2s;
  }
  .sidebar-list a:hover {
    color: var(--accent);
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--bg-elevated);
    color: var(--text-dim);
    border: 1px solid var(--border-soft);
  }
  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  @media (min-width: 900px) {
    .detail-layout {
      grid-template-columns: 1fr 280px;
      gap: 32px;
    }
  }
  @media (max-width: 480px) {
    .markdown-body { font-size: 14px; }
    .markdown-body :global(h2) { font-size: 18px; }
    .markdown-body :global(h3) { font-size: 15px; }
    .sidebar-card { padding: 12px; }
    .trait-grid { grid-template-columns: 1fr; }
  }
</style>
