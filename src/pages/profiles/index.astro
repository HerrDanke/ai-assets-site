---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'zh';
const profiles = await getCollection('profilesZh');
---

<BaseLayout title="Profiles" description="画像集合">
  <h1 class="section-title">Profiles</h1>
  <p class="section-sub">
    身份画像 · {profiles.length} 个
    <span id="filter-counter" class="filter-counter"></span>
  </p>
  <div class="card-grid">
    {profiles.map(p => (
      <a class="card" href={`/profiles/${p.slug}/`} data-slug={p.slug} data-kind="profiles">
        <div class="card-actions">
          <button class="asset-card-btn" data-slug={p.slug} data-kind="profiles" data-action="copy" title="复制 Markdown">📋</button>
          <button class="asset-card-btn" data-slug={p.slug} data-kind="profiles" data-action="download" title="下载 .md">⬇</button>
        </div>
        <h3>{p.data.title}</h3>
        <p>{p.data.description}</p>
        <div class="card-meta">
          <span class="tag kind">profile</span>
          <span class="tag version">v{p.data.version}</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<script is:inline>
  function filterCards() {
    var selected = document.body.getAttribute("data-workflow") || localStorage.getItem("sp-workflow") || "";
    var wf = selected ? window.__WORKFLOWS__[selected] : null;
    var allowed = wf ? new Set(wf.profiles || []) : null;
    var visible = 0, total = 0;
    document.querySelectorAll('.card[data-kind="profiles"]').forEach(function(card) {
      total++;
      var slug = card.getAttribute('data-slug');
      var show = !allowed || allowed.has(slug);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    var counter = document.getElementById('filter-counter');
    if (counter) counter.textContent = wf ? '（' + visible + '/' + total + '）' : '';
  }
  function initFilter() {
    var saved = localStorage.getItem('sp-workflow');
    if (saved) {
      document.body.setAttribute('data-workflow', saved);
    }
    filterCards();
  }
  document.addEventListener('workflow:filter', filterCards);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilter);
  } else {
    initFilter();
  }
</script>
