---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
---

<BaseLayout title={lang === 'en' ? 'Home' : '首页'} description={lang === 'en' ? 'AI Assets Hub' : 'AI 资产管理站'}>
  <section class="hero">
    <h1 class="hero-title">AI Assets <span class="grad">Hub</span></h1>
    <p class="hero-sub">
      {lang === 'en'
        ? 'Skills · Agents · Workflows · Prompts · Tools · Profiles — Your AI asset management hub'
        : 'Skills · Agents · Workflows · Prompts · Tools · Profiles — 一站式 AI 资产管理'}
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 60vh;
    padding: 40px 24px;
  }
  .hero-title {
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .hero-sub {
    font-size: 18px;
    color: var(--text-dim);
    max-width: 560px;
    line-height: 1.8;
  }
  .grad {
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
