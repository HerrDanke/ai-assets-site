---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCollectionSuffix } from '../../lib/i18n';
import Card from '../../components/Card.astro';
import FilterCounter from '../../components/FilterCounter.astro';

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const suffix = getCollectionSuffix(lang);
const skills = await getCollection('skills' + suffix);
---

<BaseLayout title="Skills" description="Skills collection">
  <section class="page-head">
    <div class="page-head-kicker">
      <span class="kicker">{lang === 'en' ? 'Methodologies' : '方法论'}</span>
      <span class="page-count">{skills.length}</span>
    </div>
    <h1 class="page-title">Skills</h1>
    <p class="page-desc">
      {lang === 'en' ? 'Work methodologies' : '工作方法论'}
      <FilterCounter />
    </p>
  </section>

  <div class="card-grid">
    {skills.map(s => (
      <Card
        title={s.data.title}
        description={s.data.description}
        href={`/${lang === 'en' ? 'en/' : ''}skills/${s.slug}/`}
        kind="skill"
        version={s.data.version}
        tags={s.data.tags}
      />
    ))}
  </div>
</BaseLayout>

<script>
  function filterCards() {
    var selected = document.body.getAttribute('data-workflow') || localStorage.getItem('sp-workflow') || '';
    var wf = selected ? window.__WORKFLOWS__[selected] : null;
    var allowed = wf ? new Set(wf.skills || []) : null;
    var visible = 0, total = 0;
    document.querySelectorAll('.card[data-kind="skill"]').forEach(function(card) {
      total++;
      var slug = card.getAttribute('href').split('/').filter(Boolean).pop();
      var show = !allowed || allowed.has(slug);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    var counter = document.getElementById('filter-counter');
    var lang = window.__LANG__ || 'zh';
    if (counter) counter.textContent = wf ? (lang === 'en' ? ' (' + visible + '/' + total + ')' : '（' + visible + '/' + total + '）') : '';
  }

  function initFilter() {
    var saved = localStorage.getItem('sp-workflow');
    if (saved) document.body.setAttribute('data-workflow', saved);
    filterCards();
  }

  document.addEventListener('workflow:filter', filterCards);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilter);
  } else {
    initFilter();
  }
</script>
