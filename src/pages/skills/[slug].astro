---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'zh';

export async function getStaticPaths() {
  const skills = await getCollection('skillsZh');
  return skills.map(s => ({
    params: { slug: s.slug },
    props: { entry: s },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;
---

<BaseLayout title={data.title} description={data.description}>
  <div class="detail-layout" data-kind="skill">
    <article class="detail-content">
      <span class="kicker skill">Skill</span>
      <h1 class="section-title">{data.title}</h1>
      <p class="section-sub">{data.description}</p>
      <div class="markdown-body">
        <Content />
      </div>
    </article>
    <aside class="detail-sidebar">
      {data.tags && data.tags.length > 0 && (
        <div class="sidebar-card">
          <h4>标签</h4>
          <div class="card-meta">
            {data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      )}

      {data.appliesTo && data.appliesTo.length > 0 && (
        <div class="sidebar-card">
          <h4>适用 Agent</h4>
          <ul class="sidebar-list">
            {data.appliesTo.map(agent => (
              <li><a href={`/agents/${agent}/`}>{agent}</a></li>
            ))}
          </ul>
        </div>
      )}

      {data.relatedSkills && data.relatedSkills.length > 0 && (
        <div class="sidebar-card">
          <h4>相关技能</h4>
          <ul class="sidebar-list">
            {data.relatedSkills.map(skill => (
              <li><a href={`/skills/${skill}/`}>{skill}</a></li>
            ))}
          </ul>
        </div>
      )}

      {data.relatedAgents && data.relatedAgents.length > 0 && (
        <div class="sidebar-card">
          <h4>相关 Agent</h4>
          <ul class="sidebar-list">
            {data.relatedAgents.map(agent => (
              <li><a href={`/agents/${agent}/`}>{agent}</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="sidebar-card sidebar-actions">
        <button class="asset-card-btn" data-slug={entry.slug} data-kind="skills" data-action="copy" title="复制 Markdown" style="width: 100%; height: auto; padding: 8px;">📋 复制 Markdown</button>
        <button class="asset-card-btn" data-slug={entry.slug} data-kind="skills" data-action="download" title="下载 .md" style="width: 100%; height: auto; padding: 8px;">⬇ 下载 .md</button>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  /* Hallmark · genre: modern-minimal · macrostructure: Long Document · theme: brand-violet (custom) · design-system: design.md · designed-as-app */
  .detail-layout { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  .detail-content { min-width: 0; }

  .markdown-body {
    margin-top: var(--space-lg);
    line-height: 1.8;
    font-size: var(--text-md);
    max-width: 72ch;
  }
  .markdown-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin: var(--space-xl) 0 var(--space-sm);
    font-weight: 700;
    letter-spacing: -0.02em;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-rule-soft);
  }
  .markdown-body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin: var(--space-lg) 0 var(--space-xs);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .markdown-body :global(p) { margin-bottom: var(--space-sm); color: var(--color-ink-2); }
  .markdown-body :global(ul), .markdown-body :global(ol) { margin: var(--space-xs) 0 var(--space-md); padding-left: var(--space-md); color: var(--color-ink-2); }
  .markdown-body :global(li) { margin-bottom: var(--space-2xs); }
  .markdown-body :global(table) { width: 100%; border-collapse: collapse; margin: var(--space-md) 0; font-size: var(--text-sm); }
  .markdown-body :global(th), .markdown-body :global(td) { padding: var(--space-xs) var(--space-sm); border: 1px solid var(--color-rule); text-align: left; }
  .markdown-body :global(th) { background: var(--color-elevated); font-weight: 600; }
  .markdown-body :global(code) { background: var(--color-elevated); padding: 2px 6px; border-radius: var(--radius-sm); font-size: var(--text-sm); }
  .markdown-body :global(pre) { background: var(--color-paper-2); border: 1px solid var(--color-rule-soft); border-radius: var(--radius-md); padding: var(--space-md); overflow-x: auto; margin: var(--space-md) 0; }
  .markdown-body :global(pre code) { background: none; padding: 0; }
  .markdown-body :global(blockquote) { border-left: 3px solid var(--page-accent); padding-left: var(--space-sm); color: var(--color-ink-2); margin: var(--space-sm) 0; }
  .mermaid :global(svg) { max-width: 100% !important; height: auto !important; margin: var(--space-md) 0; }

  .detail-sidebar { display: flex; flex-direction: column; gap: var(--space-sm); }
  .sidebar-card { background: var(--color-paper-2); border: 1px solid var(--color-rule-soft); border-radius: var(--radius-lg); padding: var(--space-sm); }
  .sidebar-card h4 { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-xs); color: var(--page-accent); border-left: 2px solid var(--page-accent); padding-left: var(--space-xs); }
  .sidebar-list { list-style: none; padding: 0; margin: 0; }
  .sidebar-list li { margin-bottom: var(--space-2xs); font-size: var(--text-sm); }
  .sidebar-list a { color: var(--page-accent); transition: color var(--dur-short) var(--ease-out); }
  .sidebar-list a:hover { color: var(--color-ink); }
  .card-meta { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .tag {
    font-size: var(--text-xs); padding: 2px 10px; border-radius: var(--radius-pill);
    background: var(--color-elevated); color: var(--color-ink-2);
    border: 1px solid var(--color-rule-soft); font-family: var(--font-mono);
  }
  .sidebar-actions { display: flex; flex-direction: column; gap: var(--space-xs); }
  .asset-card-btn {
    background: var(--color-elevated); border: 1px solid var(--color-rule);
    color: var(--color-ink-2); cursor: pointer; font-size: var(--text-sm);
    border-radius: var(--radius-pill);
    transition: all var(--dur-short) var(--ease-out);
    font-family: var(--font-body);
  }
  .asset-card-btn:hover { border-color: var(--page-accent); color: var(--color-ink); }
  .asset-card-btn:active { transform: translateY(1px); }

  @media (min-width: 900px) {
    .detail-layout { grid-template-columns: 1fr 280px; gap: var(--space-2xl); }
  }
  @media (max-width: 480px) {
    .markdown-body { font-size: var(--text-md); }
    .sidebar-card { padding: var(--space-xs); }
  }
</style>
