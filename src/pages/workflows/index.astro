---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCollectionSuffix } from '../../lib/i18n';
import Card from '../../components/Card.astro';
import FilterCounter from '../../components/FilterCounter.astro';

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const suffix = getCollectionSuffix(lang);
const workflows = await getCollection('workflows' + suffix);
---

<BaseLayout title="Workflows" description="Workflows collection">
  <h1 class="section-title">Workflows</h1>
  <p class="section-sub">
    {lang === 'en' ? 'Multi-Agent Pipelines' : '多 Agent 协作流水线'} · {workflows.length} {lang === 'en' ? 'total' : '个'}
    <FilterCounter />
  </p>

  <div class="card-grid">
    {workflows.map(w => (
      <Card
        title={w.data.title}
        description={w.data.description}
        href={`/${lang === 'en' ? 'en/' : ''}workflows/${w.slug}/`}
        kind="workflow"
        version={w.data.version}
        tags={w.data.tags}
        meta={w.data.stages ? (w.data.stages + ' stages') : ''}
      />
    ))}
  </div>
</BaseLayout>

<script>
  function filterCards() {
    var selected = document.body.getAttribute('data-workflow') || localStorage.getItem('sp-workflow') || '';
    var visible = 0, total = 0;
    document.querySelectorAll('.card[data-kind="workflow"]').forEach(function(card) {
      total++;
      var slug = card.getAttribute('href').split('/').filter(Boolean).pop();
      var show = !selected || slug === selected;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    var counter = document.getElementById('filter-counter');
    var lang = window.__LANG__ || 'zh';
    if (counter) counter.textContent = selected ? (lang === 'en' ? ' (' + visible + '/' + total + ')' : '（' + visible + '/' + total + '）') : '';
  }

  function initFilter() {
    var saved = localStorage.getItem('sp-workflow');
    if (saved) document.body.setAttribute('data-workflow', saved);
    filterCards();
  }

  document.addEventListener('workflow:filter', filterCards);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilter);
  } else {
    initFilter();
  }
</script>

<style>
  .section-title { font-size: clamp(22px, 3.5vw, 30px); font-weight: 700; margin-bottom: 8px; letter-spacing: -0.02em; }
  .section-sub { color: var(--text-dim); margin-bottom: 32px; }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }
  @media (max-width: 480px) {
    .card-grid { gap: 12px; }
  }
</style>
