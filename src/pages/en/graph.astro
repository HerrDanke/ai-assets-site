---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCollectionSuffix } from '../../lib/i18n';

const lang = 'en';
const suffix = getCollectionSuffix(lang);

const workflows = await getCollection('workflows' + suffix);
const allAgents = await getCollection('agents' + suffix);
const allSkills = await getCollection('skills' + suffix);
const allProfiles = await getCollection('profiles' + suffix);

const workflowGraphs: Record<string, string> = {};

for (const wf of workflows) {
  const lines: string[] = ['graph LR'];
  const participantSlugs = wf.data.participants ?? [];
  const participants = allAgents.filter(a => participantSlugs.includes(a.slug));
  const wfSkills = new Set<string>();
  const wfProfiles = new Set<string>();

  for (const agent of participants) {
    const agentId = `agent_${agent.slug}`;
    lines.push(`    ${agentId}["🤖 ${agent.data.title}"]`);
    for (const skill of (agent.data.skills ?? [])) {
      lines.push(`    ${agentId} --> skill_${skill}`);
      wfSkills.add(skill);
    }
    for (const profile of (agent.data.profiles ?? [])) {
      lines.push(`    ${agentId} -.-> profile_${profile}`);
      wfProfiles.add(profile);
    }
  }

  for (const skill of wfSkills) {
    const skillData = allSkills.find(s => s.slug === skill);
    lines.push(`    skill_${skill}["📘 ${skillData?.data.title || skill}"]`);
  }

  for (const profile of wfProfiles) {
    const profileData = allProfiles.find(p => p.slug === profile);
    lines.push(`    profile_${profile}["🧩 ${profileData?.data.title || profile}"]`);
  }

  const wfId = `wf_${wf.slug}`;
  lines.push(`    ${wfId}["⚙️ ${wf.data.title}:::workflow"]`);
  for (const participant of participantSlugs) {
    lines.push(`    ${wfId} --> agent_${participant}`);
  }

  lines.push('    classDef agent fill:#7c6cff,stroke:#7c6cff,color:#fff');
  lines.push('    classDef skill fill:#4dd6c8,stroke:#4dd6c8,color:#0a0b10');
  lines.push('    classDef profile fill:#f5a623,stroke:#f5a623,color:#0a0b10');
  lines.push('    classDef workflow fill:#ff6b6b,stroke:#ff6b6b,color:#fff');

  workflowGraphs[wf.slug] = lines.join('\n');
}

const allLines: string[] = ['graph LR'];
for (const agent of allAgents) {
  const agentId = `agent_${agent.slug}`;
  allLines.push(`    ${agentId}["🤖 ${agent.data.title}"]`);
  for (const skill of (agent.data.skills ?? [])) {
    allLines.push(`    ${agentId} --> skill_${skill}`);
  }
  for (const profile of (agent.data.profiles ?? [])) {
    allLines.push(`    ${agentId} -.-> profile_${profile}`);
  }
}
for (const skill of allSkills) {
  allLines.push(`    skill_${skill.slug}["📘 ${skill.data.title}"]`);
}
for (const profile of allProfiles) {
  allLines.push(`    profile_${profile.slug}["🧩 ${profile.data.title}"]`);
}
for (const wf of workflows) {
  const wfId = `wf_${wf.slug}`;
  allLines.push(`    ${wfId}["⚙️ ${wf.data.title}:::workflow"]`);
  for (const participant of (wf.data.participants ?? [])) {
    allLines.push(`    ${wfId} --> agent_${participant}`);
  }
}
allLines.push('    classDef agent fill:#7c6cff,stroke:#7c6cff,color:#fff');
allLines.push('    classDef skill fill:#4dd6c8,stroke:#4dd6c8,color:#0a0b10');
allLines.push('    classDef profile fill:#f5a623,stroke:#f5a623,color:#0a0b10');
allLines.push('    classDef workflow fill:#ff6b6b,stroke:#ff6b6b,color:#fff');
workflowGraphs['all'] = allLines.join('\n');
---

<BaseLayout title="Graph" description="AI asset relationship graph">
  <section class="page-head">
    <div class="page-head-kicker">
      <span class="kicker">Graph</span>
      <span class="page-count">{Object.keys(workflowGraphs).length - 1}</span>
    </div>
    <h1 class="page-title">Relationship Graph</h1>
    <p class="page-desc">Click nodes to navigate to asset details</p>
  </section>

  <div class="legend">
    <span class="legend-item"><span class="dot agent"></span> Agent</span>
    <span class="legend-item"><span class="dot skill"></span> Skill</span>
    <span class="legend-item"><span class="dot profile"></span> Profile</span>
    <span class="legend-item"><span class="dot workflow"></span> Workflow</span>
  </div>

  <div class="mermaid-graph" id="graphContainer">
    {Object.entries(workflowGraphs).map(([slug, graph]) => (
      <div class="diagram-wrapper" data-workflow={slug}>
        <pre class="mermaid">{graph}</pre>
      </div>
    ))}
  </div>

  <p class="hint" id="graphHint" style="display:none;">
    💡 Please select a workflow to view its relationship graph.
  </p>

  <script is:inline>
    function initGraph() {
      var container = document.getElementById('graphContainer');
      if (!container) return;
      var wrappers = container.querySelectorAll('.diagram-wrapper');
      var allRendered = true;
      for (var i = 0; i < wrappers.length; i++) {
        if (!wrappers[i].querySelector('svg')) {
          allRendered = false;
          break;
        }
      }
      if (!allRendered) {
        setTimeout(initGraph, 500);
        return;
      }
      var selector = document.getElementById('workflowSelector');
      var savedWorkflow = selector ? selector.value : '';
      showWorkflowDiagram(savedWorkflow);
    }

    function showWorkflowDiagram(slug) {
      var container = document.getElementById('graphContainer');
      var hint = document.getElementById('graphHint');
      if (!container) return;
      var wrappers = container.querySelectorAll('.diagram-wrapper');
      for (var i = 0; i < wrappers.length; i++) {
        wrappers[i].style.display = 'none';
      }
      if (!slug) {
        if (hint) hint.style.display = 'block';
        container.style.display = 'none';
        return;
      }
      if (hint) hint.style.display = 'none';
      container.style.display = 'block';
      var target = container.querySelector('.diagram-wrapper[data-workflow="' + slug + '"]');
      if (target) target.style.display = 'block';
      fitDiagram();
    }

    function fitDiagram() {
      var container = document.getElementById('graphContainer');
      if (!container || container.style.display === 'none') return;
      var visible = null;
      var wrappers = container.querySelectorAll('.diagram-wrapper');
      for (var i = 0; i < wrappers.length; i++) {
        if (wrappers[i].style.display !== 'none') visible = wrappers[i];
      }
      var svg = visible ? visible.querySelector('svg') : null;
      if (!svg) return;
      var w = container.clientWidth;
      var origW = parseFloat(svg.getAttribute('width')) || 100;
      var origH = parseFloat(svg.getAttribute('height')) || 100;
      var scale = w / origW;
      svg.setAttribute('width', w);
      svg.setAttribute('height', origH * scale);
      svg.style.width = w + 'px';
      svg.style.height = (origH * scale) + 'px';
    }

    document.addEventListener('workflow:filter', function() {
      var s = document.getElementById('workflowSelector');
      showWorkflowDiagram(s ? s.value : '');
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(initGraph, 1000);
      });
    } else {
      setTimeout(initGraph, 1000);
    }
  </script>
</BaseLayout>

<style>
  /* Hallmark · genre: modern-minimal · macrostructure: Map / Diagram · theme: brand-violet (custom) · design-system: design.md · designed-as-app */
  .legend { display: flex; gap: var(--space-md); margin-bottom: var(--space-lg); flex-wrap: wrap; }
  .legend-item { display: flex; align-items: center; gap: var(--space-2xs); font-size: var(--text-sm); color: var(--color-ink-2); font-family: var(--font-mono); }
  .dot { width: 12px; height: 12px; border-radius: 3px; display: inline-block; flex-shrink: 0; }
  .dot.agent { background: var(--color-accent); }
  .dot.skill { background: var(--color-accent-2); }
  .dot.profile { background: var(--color-warn); }
  .dot.workflow { background: var(--color-bad); }
  .mermaid-graph { width: 100%; overflow: auto; }
  .diagram-wrapper {
    min-width: 600px;
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    overflow-x: auto;
  }
  .mermaid :global(svg) { max-width: 100% !important; height: auto !important; }
  .hint {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    padding: var(--space-lg);
    border: 1px dashed var(--color-rule);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  @media (max-width: 768px) {
    .legend { gap: var(--space-sm); }
    .diagram-wrapper { min-width: 400px; }
  }
  @media (max-width: 480px) {
    .legend { flex-direction: column; gap: var(--space-xs); }
    .diagram-wrapper { min-width: 300px; padding: var(--space-xs); }
  }
</style>
