---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'en';
const tools = await getCollection('toolsEn');
---

<BaseLayout title="Tools" description="MCP servers and tools">
  <h1 class="section-title">Tools</h1>
  <p class="section-sub">MCP servers / CLI tools / APIs · {tools.length} total</p>

  {tools.length === 0 ? (
    <p style="color: var(--text-faint); text-align: center; padding: 40px;">No tools yet</p>
  ) : (
    <div class="card-grid">
      {tools.map(t => (
        <a class="card" href={`/en/tools/${t.slug}/`} data-slug={t.slug} data-kind="tools">
          <div class="card-actions">
            <button class="asset-card-btn" data-slug={t.slug} data-kind="tools" data-action="copy" title="Copy Markdown">📋</button>
            <button class="asset-card-btn" data-slug={t.slug} data-kind="tools" data-action="download" title="Download .md">⬇</button>
          </div>
          <h3>{t.data.title}</h3>
          <p>{t.data.description}</p>
          <div class="card-meta">
            <span class="tag kind">{t.data.toolType ? t.data.toolType.replace('_', ' ') : 'tool'}</span>
            <span class="tag version">v{t.data.version}</span>
            {t.data.tags.slice(0, 2).map(tag => <span class="tag">#{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
