---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

const skills = await getCollection('skillsEn');
const agents = await getCollection('agentsEn');
const workflows = await getCollection('workflowsEn');
const profiles = await getCollection('profilesEn');

const stats = [
  { label: 'Skills', count: skills.length, href: '/en/skills/' },
  { label: 'Agents', count: agents.length, href: '/en/agents/' },
  { label: 'Workflows', count: workflows.length, href: '/en/workflows/' },
  { label: 'Profiles', count: profiles.length, href: '/en/profiles/' },
];
---

<BaseLayout title="Home" description="AI Assets Hub">
  <div id="homeAll" style="display:none;">
    <section class="hero-large">
      <h1 class="hero-title-large">AI Assets <span class="grad">Hub</span></h1>
      <p class="hero-sub-large">Manage and showcase your AI assets</p>
    </section>

    <section>
      <div class="stat-grid">
        {stats.map(s => (
          <a class="stat-link" href={s.href}>
            <div class="stat">
              <b>{s.count}</b>
              <span>{s.label}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <div id="homeWorkflow" style="display:none;">
    <div class="workflow-tech" id="workflowContent"></div>
  </div>
</BaseLayout>

<script is:inline>
  function initHome() {
    var saved = localStorage.getItem('sp-workflow') || document.getElementById('workflowSelector').value;
    var allDiv = document.getElementById('homeAll');
    var wfDiv = document.getElementById('homeWorkflow');
    var contentDiv = document.getElementById('workflowContent');

    if (!saved) {
      allDiv.style.display = 'block';
      wfDiv.style.display = 'none';
    } else {
      allDiv.style.display = 'none';
      wfDiv.style.display = 'block';

      var overview = window.__WORKFLOW_DETAILS__ && window.__WORKFLOW_DETAILS__[saved] ? window.__WORKFLOW_DETAILS__[saved] : null;
      var wf = window.__WORKFLOWS__[saved];
      var html = '';
      if (overview) {
        html += '<section style="text-align:center;padding:80px 0 60px;">';
        html += '<h1 class="hero-title-large"><span style="background:linear-gradient(110deg,#7c6cff 0%,#4dd6c8 100%);-webkit-background-clip:text;background-clip:text;color:transparent;">' + (wf ? wf.title : saved) + '</span></h1>';
        html += '</section>';
        if (overview.overview) {
          html += '<section class="workflow-section"><h2 class="section-sub" style="text-align:center;">Overview</h2><div class="content">' + overview.overview + '</div></section>';
        }
        if (overview.designPhilosophy) {
          html += '<section class="workflow-section"><h2 class="section-sub" style="text-align:center;">Design Philosophy</h2><div class="card-grid">' + renderCards(overview.designPhilosophy) + '</div></section>';
        }
      } else {
        html = '<section class="hero-large"><h1 class="hero-title-large">Please select a workflow</h1></section>';
      }

      function renderCards(text) {
        var cards = '';
        var sections = text.split(/^(?=## )/m);
        for (var i = 0; i < sections.length; i++) {
          var section = sections[i].trim();
          if (!section) continue;
          var lines = section.split('\n');
          var sectionTitle = lines[0].replace(/^##\s*/, '');
          var restContent = lines.slice(1).join('\n').trim();

          var subParts = restContent.split(/^(?=### )/m);
          if (subParts.length > 1) {
            for (var j = 0; j < subParts.length; j++) {
              var part = subParts[j].trim();
              if (!part) continue;
              var partLines = part.split('\n');
              var subTitle = partLines[0].replace(/^###\s*/, '');
              var subContent = partLines.slice(1).join('\n').trim();
              cards += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:20px;min-height:160px;display:flex;flex-direction:column;">';
              cards += '<h3 style="font-size:15px;font-weight:600;margin:0 0 10px;color:var(--accent-2);">' + subTitle + '</h3>';
              if (subContent) {
                cards += '<div style="line-height:1.7;color:var(--text-dim);flex:1;font-size:13px;"><p style="margin:0;">' + subContent.replace(/\n/g, '<br>') + '</p></div>';
              }
              cards += '</div>';
            }
          } else {
            cards += '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:20px;min-height:160px;display:flex;flex-direction:column;">';
            cards += '<h3 style="font-size:15px;font-weight:600;margin:0 0 10px;color:var(--accent-2);">' + sectionTitle + '</h3>';
            if (restContent) {
              cards += '<div style="line-height:1.7;color:var(--text-dim);flex:1;font-size:13px;"><p style="margin:0;">' + restContent.replace(/\n/g, '<br>') + '</p></div>';
            }
            cards += '</div>';
          }
        }
        return cards;
      }
      contentDiv.innerHTML = html;
    }
  }

  document.addEventListener('workflow:filter', initHome);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { setTimeout(initHome, 500); });
  } else {
    setTimeout(initHome, 500);
  }
</script>

<style>
  .hero-large { text-align: center; padding: 80px 0 60px; }
  .hero-title-large {
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
    color: var(--text);
  }
  .hero-title-large .grad {
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub-large { font-size: 20px; color: var(--text-dim); }
  .stat-link { text-decoration: none; color: inherit; }
  .stat-link .stat { cursor: pointer; transition: transform 0.2s, border-color 0.2s; }
  .stat-link:hover .stat { transform: translateY(-4px); border-color: var(--accent); }
  .workflow-section { max-width: 900px; margin: 0 auto 40px; padding: 0 24px; }
  .workflow-section .section-sub { font-size: 24px; font-weight: 600; margin-bottom: 20px; color: var(--text); text-align: center; }
  .workflow-section .content { line-height: 1.8; color: var(--text); }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    min-height: 160px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }
  .info-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .info-card h3 {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 10px;
    color: var(--accent-2);
  }
  .info-card .body {
    line-height: 1.7;
    color: var(--text-dim);
    flex: 1;
    font-size: 13px;
  }
  .info-card .body p { margin: 0; }
</style>
