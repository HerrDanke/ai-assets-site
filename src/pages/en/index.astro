---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'en';
---

<BaseLayout title="Home" description="AI Assets Hub">
  <section class="hero">
    <h1 class="hero-title">AI Assets <em>Hub</em></h1>
    <p class="hero-sub">
      Skills · Agents · Workflows · Profiles — a curated index of reusable AI assets.
    </p>
  </section>
</BaseLayout>

<style>
  /* Hallmark · genre: modern-minimal · macrostructure: Marquee Hero · theme: brand-violet (custom) · design-system: design.md · designed-as-app */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 68vh;
    padding: var(--space-xl) var(--space-md);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .hero-title em {
    font-style: normal;
    color: var(--color-accent);
  }
  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    max-width: 46ch;
    line-height: 1.7;
    margin-top: var(--space-md);
  }
</style>
