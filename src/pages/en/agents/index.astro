---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCollectionSuffix } from '../../../lib/i18n';
import Card from '../../../components/Card.astro';
import FilterCounter from '../../../components/FilterCounter.astro';

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const suffix = getCollectionSuffix(lang);
const agents = await getCollection('agents' + suffix);
---

<BaseLayout title="Agents" description="Agents collection">
  <h1 class="section-title">Agents</h1>
  <p class="section-sub">
    {lang === 'en' ? 'Role Presets' : '角色预设'} · {agents.length} {lang === 'en' ? 'total' : '个'}
    <FilterCounter />
  </p>

  <div class="card-grid">
    {agents.map(a => (
      <Card
        title={a.data.title}
        description={a.data.description}
        href={`/${lang === 'en' ? 'en/' : ''}agents/${a.slug}/`}
        kind="agent"
        version={a.data.version}
        tags={a.data.tags}
        meta={a.data.skills ? a.data.skills.length + ' skills' : ''}
      />
    ))}
  </div>
</BaseLayout>

<script>
  function filterCards() {
    var selected = document.body.getAttribute('data-workflow') || localStorage.getItem('sp-workflow') || '';
    var wf = selected ? window.__WORKFLOWS__[selected] : null;
    var allowed = wf ? new Set(wf.agents || []) : null;
    var visible = 0, total = 0;
    document.querySelectorAll('.card[data-kind="agent"]').forEach(function(card) {
      total++;
      var slug = card.getAttribute('href').split('/').filter(Boolean).pop();
      var show = !allowed || allowed.has(slug);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    var counter = document.getElementById('filter-counter');
    var lang = window.__LANG__ || 'zh';
    if (counter) counter.textContent = wf ? (lang === 'en' ? ' (' + visible + '/' + total + ')' : '（' + visible + '/' + total + '）') : '';
  }

  function initFilter() {
    var saved = localStorage.getItem('sp-workflow');
    if (saved) document.body.setAttribute('data-workflow', saved);
    filterCards();
  }

  document.addEventListener('workflow:filter', filterCards);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilter);
  } else {
    initFilter();
  }
</script>

<style>
  .section-title { font-size: clamp(22px, 3.5vw, 30px); font-weight: 700; margin-bottom: 8px; letter-spacing: -0.02em; }
  .section-sub { color: var(--text-dim); margin-bottom: 32px; }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }
  @media (max-width: 480px) {
    .card-grid { gap: 12px; }
  }
</style>
