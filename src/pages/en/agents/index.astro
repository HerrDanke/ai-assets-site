---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'en';
const agents = await getCollection('agentsEn');
---

<BaseLayout title="Agents" description="Agents collection">
  <h1 class="section-title">Agents</h1>
  <p class="section-sub">Intelligent agent roles · {agents.length} items <span id="filter-counter" class="filter-counter"></span></p>
  <div class="card-grid">
    {agents.map(a => (
      <a class="card" href={`/en/agents/${a.slug}/`} data-slug={a.slug} data-kind="agents">
        <div class="card-actions">
          <button class="asset-card-btn" data-slug={a.slug} data-kind="agents" data-action="copy" title="Copy Markdown">📋</button>
          <button class="asset-card-btn" data-slug={a.slug} data-kind="agents" data-action="download" title="Download .md">⬇</button>
        </div>
        <h3>{a.data.title}</h3>
        <p>{a.data.description}</p>
        <div class="card-meta">
          <span class="tag kind">agent</span>
          <span class="tag version">v{a.data.version}</span>
          {a.data.role && <span class="tag">{a.data.role}</span>}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<script is:inline>
  function filterCards() {
    var selected = document.body.getAttribute("data-workflow") || localStorage.getItem("sp-workflow") || "";
    var wf = selected ? window.__WORKFLOWS__[selected] : null;
    var allowed = wf ? new Set(wf.agents || []) : null;
    var visible = 0, total = 0;
    document.querySelectorAll('.card[data-kind="agents"]').forEach(function(card) {
      total++;
      var slug = card.getAttribute('data-slug');
      var show = !allowed || allowed.has(slug);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    var counter = document.getElementById('filter-counter');
    if (counter) counter.textContent = wf ? '(' + visible + '/' + total + ')' : '';
  }
  function initFilter() {
    var saved = localStorage.getItem('sp-workflow');
    if (saved) {
      document.body.setAttribute('data-workflow', saved);
    }
    filterCards();
  }
  document.addEventListener('workflow:filter', filterCards);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilter);
  } else {
    initFilter();
  }
</script>
