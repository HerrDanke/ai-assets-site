---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'en';
const prompts = await getCollection('promptsEn');
---

<BaseLayout title="Prompts" description="Reusable prompts">
  <h1 class="section-title">Prompts</h1>
  <p class="section-sub">Reusable prompts · {prompts.length} total</p>

  {prompts.length === 0 ? (
    <p style="color: var(--text-faint); text-align: center; padding: 40px;">No prompts yet</p>
  ) : (
    <div class="card-grid">
      {prompts.map(p => (
        <a class="card" href={`/en/prompts/${p.slug}/`} data-slug={p.slug} data-kind="prompts">
          <div class="card-actions">
            <button class="asset-card-btn" data-slug={p.slug} data-kind="prompts" data-action="copy" title="Copy Markdown">📋</button>
            <button class="asset-card-btn" data-slug={p.slug} data-kind="prompts" data-action="download" title="Download .md">⬇</button>
          </div>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <div class="card-meta">
            <span class="tag kind">prompt</span>
            <span class="tag version">v{p.data.version}</span>
            {p.data.tags.slice(0, 2).map(t => <span class="tag">#{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
