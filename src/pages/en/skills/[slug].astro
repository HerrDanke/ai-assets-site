---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

export async function getStaticPaths() {
  const skills = await getCollection('skillsEn');
  return skills.map(s => ({
    params: { slug: s.slug },
    props: { entry: s },
  }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();
const { data } = entry;
---

<BaseLayout title={data.title} description={data.description}>
  <div class="detail-layout">
    <article class="detail-content">
      <h1 class="section-title">{data.title}</h1>
      <p class="section-sub">{data.description}</p>
      <div class="markdown-body">
        <Content />
      </div>
    </article>
    <aside class="detail-sidebar">
      {data.tags && data.tags.length > 0 && (
        <div class="sidebar-card">
          <h4>Tags</h4>
          <div class="card-meta">
            {data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      )}

      {data.appliesTo && data.appliesTo.length > 0 && (
        <div class="sidebar-card">
          <h4>Applies To</h4>
          <ul class="sidebar-list">
            {data.appliesTo.map(agent => (
              <li><a href={`/en/agents/${agent}/`}>{agent}</a></li>
            ))}
          </ul>
        </div>
      )}

      {data.relatedSkills && data.relatedSkills.length > 0 && (
        <div class="sidebar-card">
          <h4>Related Skills</h4>
          <ul class="sidebar-list">
            {data.relatedSkills.map(skill => (
              <li><a href={`/en/skills/${skill}/`}>{skill}</a></li>
            ))}
          </ul>
        </div>
      )}

      {data.relatedAgents && data.relatedAgents.length > 0 && (
        <div class="sidebar-card">
          <h4>Related Agents</h4>
          <ul class="sidebar-list">
            {data.relatedAgents.map(agent => (
              <li><a href={`/en/agents/${agent}/`}>{agent}</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="sidebar-card sidebar-actions">
        <button class="asset-card-btn" data-slug={entry.slug} data-kind="skills" data-action="copy" title="Copy Markdown" style="width: 100%; height: auto; padding: 8px;">📋 Copy Markdown</button>
        <button class="asset-card-btn" data-slug={entry.slug} data-kind="skills" data-action="download" title="Download .md" style="width: 100%; height: auto; padding: 8px;">⬇ Download .md</button>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .detail-content { min-width: 0; }
  .markdown-body {
    margin-top: 24px;
    line-height: 1.8;
    font-size: 15px;
  }
  .markdown-body :global(h2) {
    font-size: 20px;
    margin: 32px 0 12px;
    font-weight: 600;
  }
  .markdown-body :global(h3) {
    font-size: 17px;
    margin: 24px 0 10px;
    font-weight: 600;
  }
  .markdown-body :global(p) {
    margin-bottom: 16px;
    color: var(--text-dim);
  }
  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin: 12px 0 16px;
    padding-left: 24px;
    color: var(--text-dim);
  }
  .markdown-body :global(li) {
    margin-bottom: 6px;
  }
  .markdown-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 14px;
  }
  .markdown-body :global(th), .markdown-body :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--border);
    text-align: left;
  }
  .markdown-body :global(th) {
    background: var(--bg-elevated);
    font-weight: 600;
  }
  .markdown-body :global(code) {
    background: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
  }
  .markdown-body :global(pre) {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    overflow-x: auto;
  }
  .mermaid :global(svg) {
    max-width: 100% !important;
    height: auto !important;
    margin: 16px 0;
  }
  .markdown-body :global(pre code) {
    background: none;
    padding: 0;
  }
  .detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sidebar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }
  .sidebar-card h4 {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--text);
  }
  .sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-list li {
    margin-bottom: 6px;
    font-size: 13px;
  }
  .sidebar-list a {
    color: var(--accent-2);
    transition: color 0.2s;
  }
  .sidebar-list a:hover {
    color: var(--accent);
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--bg-elevated);
    color: var(--text-dim);
    border: 1px solid var(--border-soft);
  }
  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  @media (min-width: 900px) {
    .detail-layout {
      grid-template-columns: 1fr 280px;
      gap: 32px;
    }
  }
  @media (max-width: 480px) {
    .markdown-body { font-size: 14px; }
    .markdown-body :global(h2) { font-size: 18px; }
    .markdown-body :global(h3) { font-size: 15px; }
    .sidebar-card { padding: 12px; }
  }
</style>
