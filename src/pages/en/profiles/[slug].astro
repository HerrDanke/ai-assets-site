---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

export async function getStaticPaths() {
  const profiles = await getCollection('profilesEn');
  return profiles.map(p => ({
    params: { slug: p.slug },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;
---

<BaseLayout title={data.title} description={data.description}>
  <div class="detail-layout" data-kind="profile">
    <article class="detail-content">
      <span class="kicker profile">Profile</span>
      <h1 class="section-title">{data.title}</h1>
      <p class="section-sub">{data.description}</p>
      <div class="markdown-body">
        {data.traits && data.traits.length > 0 && (
          <section class="profile-section">
            <h2>Traits</h2>
            <div class="trait-grid">
              {data.traits.map(trait => (
                <div class="trait-card">
                  <span class="trait-icon">✦</span>
                  <span>{trait}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {data.thinkingStyle && data.thinkingStyle.length > 0 && (
          <section class="profile-section">
            <h2>Thinking Style</h2>
            <div class="thinking-list">
              {data.thinkingStyle.map((style, i) => (
                <div class="thinking-item">
                  <span class="thinking-num">{i + 1}</span>
                  <span>{style}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {data.applicableScenarios && data.applicableScenarios.length > 0 && (
          <section class="profile-section">
            <h2>Applicable Scenarios</h2>
            <div class="scenario-tags">
              {data.applicableScenarios.map(scene => (
                <span class="scenario-tag">{scene}</span>
              ))}
            </div>
          </section>
        )}

        <Content />
      </div>
    </article>
    <aside class="detail-sidebar">
      {data.tags && data.tags.length > 0 && (
        <div class="sidebar-card">
          <h4>Tags</h4>
          <div class="card-meta">
            {data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      )}

      {data.usedBy && data.usedBy.length > 0 && (
        <div class="sidebar-card">
          <h4>Used By</h4>
          <ul class="sidebar-list">
            {data.usedBy.map(agent => (
              <li><a href={`/en/agents/${agent}/`}>{agent}</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="sidebar-card sidebar-actions">
        <button class="asset-card-btn" data-slug={entry.slug} data-kind="profiles" data-action="copy" title="Copy Markdown" style="width: 100%; height: auto; padding: 8px;">📋 Copy Markdown</button>
        <button class="asset-card-btn" data-slug={entry.slug} data-kind="profiles" data-action="download" title="Download .md" style="width: 100%; height: auto; padding: 8px;">⬇ Download .md</button>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  /* Hallmark · genre: modern-minimal · macrostructure: Long Document · theme: brand-violet (custom) · design-system: design.md · designed-as-app */
  .detail-layout { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  .detail-content { min-width: 0; }

  .markdown-body {
    margin-top: var(--space-lg);
    line-height: 1.8;
    font-size: var(--text-md);
    max-width: 72ch;
  }

  .profile-section { margin-bottom: var(--space-xl); }
  .profile-section h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin: var(--space-xl) 0 var(--space-md);
    font-weight: 700;
    letter-spacing: -0.02em;
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--page-accent);
    display: inline-block;
  }
  .profile-section h2:first-of-type { margin-top: var(--space-md); }

  .trait-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-xs); }
  .trait-card {
    display: flex; align-items: flex-start; gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule-soft);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.6;
    transition: border-color var(--dur-md) var(--ease-out), transform var(--dur-md) var(--ease-out);
  }
  .trait-card:hover { border-color: var(--color-accent-2); transform: translateY(-2px); }
  .trait-icon { color: var(--page-accent); font-size: var(--text-sm); margin-top: 2px; flex-shrink: 0; }

  .thinking-list { display: flex; flex-direction: column; gap: var(--space-xs); }
  .thinking-item {
    display: flex; align-items: flex-start; gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-paper-2);
    border-left: 3px solid var(--page-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .thinking-num {
    display: flex; align-items: center; justify-content: center;
    width: 26px; height: 26px;
    background: var(--page-accent);
    color: var(--color-paper);
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: 50%;
    flex-shrink: 0; margin-top: 1px;
    font-family: var(--font-mono);
  }

  .scenario-tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .scenario-tag {
    padding: var(--space-xs) var(--space-md);
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule-soft);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    transition: all var(--dur-short) var(--ease-out);
  }
  .scenario-tag:hover { border-color: var(--page-accent); color: var(--page-accent); }

  .markdown-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin: var(--space-xl) 0 var(--space-sm);
    font-weight: 700;
    letter-spacing: -0.02em;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-rule-soft);
  }
  .markdown-body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin: var(--space-lg) 0 var(--space-xs);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .markdown-body :global(p) { margin-bottom: var(--space-sm); color: var(--color-ink-2); }
  .markdown-body :global(ul), .markdown-body :global(ol) { margin: var(--space-xs) 0 var(--space-md); padding-left: var(--space-md); color: var(--color-ink-2); }
  .markdown-body :global(li) { margin-bottom: var(--space-2xs); }
  .markdown-body :global(table) { width: 100%; border-collapse: collapse; margin: var(--space-md) 0; font-size: var(--text-sm); }
  .markdown-body :global(th), .markdown-body :global(td) { padding: var(--space-xs) var(--space-sm); border: 1px solid var(--color-rule); text-align: left; }
  .markdown-body :global(th) { background: var(--color-elevated); font-weight: 600; }
  .markdown-body :global(code) { background: var(--color-elevated); padding: 2px 6px; border-radius: var(--radius-sm); font-size: var(--text-sm); }
  .markdown-body :global(pre) { background: var(--color-paper-2); border: 1px solid var(--color-rule-soft); border-radius: var(--radius-md); padding: var(--space-md); overflow-x: auto; margin: var(--space-md) 0; }
  .markdown-body :global(pre code) { background: none; padding: 0; }
  .markdown-body :global(blockquote) { border-left: 3px solid var(--page-accent); padding-left: var(--space-sm); color: var(--color-ink-2); margin: var(--space-sm) 0; }
  .mermaid :global(svg) { max-width: 100% !important; height: auto !important; margin: var(--space-md) 0; }

  .detail-sidebar { display: flex; flex-direction: column; gap: var(--space-sm); }
  .sidebar-card { background: var(--color-paper-2); border: 1px solid var(--color-rule-soft); border-radius: var(--radius-lg); padding: var(--space-sm); }
  .sidebar-card h4 { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-xs); color: var(--page-accent); border-left: 2px solid var(--page-accent); padding-left: var(--space-xs); }
  .sidebar-list { list-style: none; padding: 0; margin: 0; }
  .sidebar-list li { margin-bottom: var(--space-2xs); font-size: var(--text-sm); color: var(--color-ink-2); }
  .sidebar-list a { color: var(--page-accent); transition: color var(--dur-short) var(--ease-out); }
  .sidebar-list a:hover { color: var(--color-ink); }
  .card-meta { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .tag {
    font-size: var(--text-xs); padding: 2px 10px; border-radius: var(--radius-pill);
    background: var(--color-elevated); color: var(--color-ink-2);
    border: 1px solid var(--color-rule-soft); font-family: var(--font-mono);
  }
  .sidebar-actions { display: flex; flex-direction: column; gap: var(--space-xs); }
  .asset-card-btn {
    background: var(--color-elevated); border: 1px solid var(--color-rule);
    color: var(--color-ink-2); cursor: pointer; font-size: var(--text-sm);
    border-radius: var(--radius-pill);
    transition: all var(--dur-short) var(--ease-out);
    font-family: var(--font-body);
  }
  .asset-card-btn:hover { border-color: var(--page-accent); color: var(--color-ink); }
  .asset-card-btn:active { transform: translateY(1px); }

  @media (min-width: 900px) {
    .detail-layout { grid-template-columns: 1fr 280px; gap: var(--space-2xl); }
  }
  @media (max-width: 480px) {
    .markdown-body { font-size: var(--text-md); }
    .sidebar-card { padding: var(--space-xs); }
    .trait-grid { grid-template-columns: 1fr; }
  }
</style>
