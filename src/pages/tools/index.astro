---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'zh';
const tools = await getCollection('toolsZh');
---

<BaseLayout title="Tools" description="MCP 服务器与工具列表">
  <h1 class="section-title">Tools</h1>
  <p class="section-sub">MCP 服务器 / CLI 工具 / API · {tools.length} 个</p>

  {tools.length === 0 ? (
    <p style="color: var(--text-faint); text-align: center; padding: 40px;">暂无工具内容</p>
  ) : (
    <div class="card-grid">
      {tools.map(t => (
        <a class="card" href={`/tools/${t.slug}/`} data-slug={t.slug} data-kind="tools">
          <div class="card-actions">
            <button class="asset-card-btn" data-slug={t.slug} data-kind="tools" data-action="copy" title="复制 Markdown">📋</button>
            <button class="asset-card-btn" data-slug={t.slug} data-kind="tools" data-action="download" title="下载 .md">⬇</button>
          </div>
          <h3>{t.data.title}</h3>
          <p>{t.data.description}</p>
          <div class="card-meta">
            <span class="tag kind">{t.data.toolType ? t.data.toolType.replace('_', ' ') : 'tool'}</span>
            <span class="tag version">v{t.data.version}</span>
            {t.data.tags.slice(0, 2).map(tag => <span class="tag">#{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
